# --- LLM provider (auto | openai | openrouter | anthropic) ---
# "auto" prefers OpenRouter when OPENROUTER_API_KEY is set, then Anthropic,
# then OpenAI. For free-tier testing, use OpenRouter.
LLM_PROVIDER=auto
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- OpenRouter (OpenAI-compatible, free models available) ---
# Sign up at https://openrouter.ai and create a key. Free models (verified):
#   google/gemma-4-31b-it:free          (recommended; supports tool calling)
#   nvidia/nemotron-3-super-120b-a12b:free
#   google/gemma-4-26b-a4b-it:free
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- LangSmith (tracing + evaluation) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-e2e-platform
LANGSMITH_TRACING=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_e2e

# --- Vector store ---
VECTOR_STORE_URL=http://localhost:6333
VECTOR_STORE_COLLECTION=test_knowledge
EMBEDDING_MODEL=text-embedding-3-small

# --- Playwright ---
BROWSER_HEADLESS=true
BROWSER_TYPE=chromium

# --- Workflow ---
MAX_RETRIES=3
MAX_HEAL_RETRIES=2
HUMAN_APPROVAL_REQUIRED=true

# --- Security ---
SECRET_KEY=change-me
ADMIN_API_TOKEN=
ALLOW_UNAUTHENTICATED=true

# --- Google Gemini (native, OpenAI-compatible endpoint) ---
# Get a key at https://aistudio.google.com/apikey. Recommended model:
#   gemini-2.5-flash   (fast, cheap, reliable function calling)
LLM_PROVIDER=google
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
