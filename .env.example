# ============================================================
# ai-e2e-platform — environment configuration
# Copy to .env and fill in your values. `.env` is gitignored.
# ============================================================

# --- LLM provider: auto | openai | openrouter | anthropic | google | groq ---
# "auto" prefers Gemini, then Groq, then OpenRouter, then Anthropic, then OpenAI.
# NOTE: structured_invoke() automatically FAILS OVER across all configured
# providers — when one returns HTTP 429 (quota exhausted), the next is tried.
LLM_PROVIDER=auto
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- OpenRouter (OpenAI-compatible; free models available) ---
# Sign up at https://openrouter.ai. Free models (verified):
#   google/gemma-4-26b-a4b-it:free   (recommended; supports tool calling)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# --- Google Gemini (native; OpenAI-compatible endpoint) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Groq (OpenAI-compatible; free tier with fast llama models) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- LangSmith (tracing + evaluation; optional) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-e2e-platform
LANGSMITH_TRACING=true

# --- Database ---
# Dev (zero-infra): sqlite+aiosqlite:///./e2e.db
# Prod:            postgresql+asyncpg://user:pass@host:5432/ai_e2e
DATABASE_URL=sqlite+aiosqlite:///./e2e.db

# --- Vector store (optional; Qdrant) ---
VECTOR_STORE_URL=http://localhost:6333
VECTOR_STORE_COLLECTION=test_knowledge
EMBEDDING_MODEL=text-embedding-3-small

# --- Playwright ---
BROWSER_HEADLESS=true
BROWSER_TYPE=chromium
BROWSER_TIMEOUT_MS=30000
BROWSER_SLOW_MO=0

# --- Workflow ---
MAX_RETRIES=3
MAX_HEAL_RETRIES=2
HUMAN_APPROVAL_REQUIRED=true
WORKER_CONCURRENCY=1

# --- Security ---
# SECRET_KEY must be >=32 bytes for production JWT signing.
# (Uncomment and set a long random string in production.)
# SECRET_KEY=change-this-to-a-long-random-string
ADMIN_API_TOKEN=
ALLOW_UNAUTHENTICATED=true
